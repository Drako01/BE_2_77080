NODE_ENV=development
PORT=8000

# DB target: LOCAL | ATLAS
MONGO_TARGET=LOCAL
MONGO_URL=mongodb://127.0.0.1:27017/backend77080
MONGO_ATLAS_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Session/JWT secrets (change in real environments)
SECRET_SESSION=change_me_session_secret
JWT_SECRET=change_me_jwt_secret

# Optional: GitHub OAuth (required only if strategy is enabled)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
